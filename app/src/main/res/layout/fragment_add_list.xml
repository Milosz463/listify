<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AddListFragment"
    android:padding="10dp">

    <Button
        android:id="@+id/buttonGoBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
       android:background="@android:color/transparent"
        android:textColor="@color/black"
        android:text="BACK" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="32dp"
        android:padding="5dp"
        android:textStyle="bold"
        android:textColor="#00B8FF"
        android:text="NAZWA LISTY" />


    <EditText
        android:id="@+id/editTextListName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edittext_border"
        android:padding="10dp"
        android:ems="10"
        android:inputType="text"

        />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="32dp"
        android:padding="5dp"
        android:textStyle="bold"
        android:textColor="#00B8FF"
        android:text="PRODUKTY" />

    <ListView
        android:id="@+id/listViewProducts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    </ListView>

    <EditText
        android:id="@+id/editTextTextProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edittext_border"
        android:padding="10dp"
        android:ems="10"
        android:layout_margin="5dp"
        android:inputType="text"
        />

    <Button
        android:id="@+id/buttonAddProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="5dp"
        android:textSize="32dp"
        android:backgroundTint="#8122c0"
        android:text="DODAJ PRODUKT" />

    <Button
        android:id="@+id/buttonConfirmList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textSize="32dp"
        android:layout_margin="5dp"
        android:backgroundTint="#8122c0"
        android:text="ZATWIERDŹ LISTĘ" />
</LinearLayout>